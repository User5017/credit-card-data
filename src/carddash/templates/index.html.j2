<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ site_title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site_url }}">
<meta property="og:image" content="{{ preview_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="675">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ site_title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ preview_image }}">
<link rel="canonical" href="{{ site_url }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='7' width='28' height='18' rx='3' fill='%232a78d6'/%3E%3Crect x='2' y='11' width='28' height='4' fill='%230b0b0b'/%3E%3Crect x='6' y='18' width='10' height='3' rx='1' fill='%23ffffff'/%3E%3C/svg%3E">
<script>try{var t=localStorage.getItem('carddash-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
<style>
{{ uplot_css | safe }}
:root {
  color-scheme: light;
  --bg: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink2: #52514e; --muted: #6f6d67;
  --grid: #e1e0d9; --axis: #c3c2b7; --border: rgba(11,11,11,.10);
  --series-1: #2a78d6; --series-2: #c9541c; --series-3: #0f8a5e; --series-4: #7a4fd0;
  --series-5: #6b6a66; --series-6: #b5176a; --series-7: #8d5524; --series-8: #0e7c8a;
  --band: rgba(42,120,214,.12); --recession: rgba(11,11,11,.06);
  --good: #0ca30c; --warning: #d99a0b; --critical: #d03b3b;
  /* Sequential ramp for the state map: ONE hue, light to dark, six steps. Magnitude, not identity,
     so it never borrows the series colors. Each step ships the ink that clears 4.5:1 on it. */
  --seq-0:#fdf0e6; --seq-1:#f9d6bb; --seq-2:#f2b58c; --seq-3:#e68a58; --seq-4:#d1602c; --seq-5:#a3400f;
  --seq-ink-0:#0b0b0b; --seq-ink-1:#0b0b0b; --seq-ink-2:#0b0b0b; --seq-ink-3:#0b0b0b; --seq-ink-4:#0b0b0b; --seq-ink-5:#ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink2: #c3c2b7; --muted: #9b9a94;
    --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,.10);
    --series-1: #4d8fe0; --series-2: #f07a3c; --series-3: #2dbd86; --series-4: #a78bea;
    --series-5: #a3a29b; --series-6: #ef5aa0; --series-7: #d3945a; --series-8: #3cb7c8;
    --band: rgba(77,143,224,.18); --recession: rgba(255,255,255,.06);
    --warning: #fab219;
    /* Dark is chosen, not flipped: the ramp's anchor moves so the high end carries weight on a dark surface. */
    --seq-0:#3a2317; --seq-1:#5c3319; --seq-2:#85451c; --seq-3:#b05a22; --seq-4:#db7a34; --seq-5:#f7a35f;
    --seq-ink-0:#ffffff; --seq-ink-1:#ffffff; --seq-ink-2:#ffffff; --seq-ink-3:#ffffff; --seq-ink-4:#0b0b0b; --seq-ink-5:#0b0b0b;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0d0d0d; --surface: #1a1a19; --ink: #ffffff; --ink2: #c3c2b7; --muted: #9b9a94;
  --grid: #2c2c2a; --axis: #383835; --border: rgba(255,255,255,.10);
  --series-1: #4d8fe0; --series-2: #f07a3c; --series-3: #2dbd86; --series-4: #a78bea;
  --series-5: #a3a29b; --series-6: #ef5aa0; --series-7: #d3945a; --series-8: #3cb7c8;
  --band: rgba(77,143,224,.18); --recession: rgba(255,255,255,.06);
  --warning: #fab219;
  --seq-0:#3a2317; --seq-1:#5c3319; --seq-2:#85451c; --seq-3:#b05a22; --seq-4:#db7a34; --seq-5:#f7a35f;
  --seq-ink-0:#ffffff; --seq-ink-1:#ffffff; --seq-ink-2:#ffffff; --seq-ink-3:#ffffff; --seq-ink-4:#0b0b0b; --seq-ink-5:#0b0b0b;
}
.statemap { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px 16px; }
.statemap .controls { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; margin-bottom: 12px; }
.statemap .controls label { font-size: 12px; color: var(--ink2); }
.statemap input[type=range] { vertical-align: middle; }
.tilegrid { display: grid; gap: 3px; grid-template-columns: repeat(12, minmax(0, 1fr)); max-width: 720px; }
.tile { position: relative; aspect-ratio: 1/1; border-radius: 3px; display: flex; align-items: center;
        justify-content: center; font-size: 11px; font-weight: 600; letter-spacing: .02em;
        background: var(--grid); color: var(--muted); cursor: default; }
.tile[data-has="1"] { cursor: pointer; }
.tile.b0, .sw.b0 { background: var(--seq-0); }
.tile.b0 { color: var(--seq-ink-0); }
.tile.b1, .sw.b1 { background: var(--seq-1); }
.tile.b1 { color: var(--seq-ink-1); }
.tile.b2, .sw.b2 { background: var(--seq-2); }
.tile.b2 { color: var(--seq-ink-2); }
.tile.b3, .sw.b3 { background: var(--seq-3); }
.tile.b3 { color: var(--seq-ink-3); }
.tile.b4, .sw.b4 { background: var(--seq-4); }
.tile.b4 { color: var(--seq-ink-4); }
.tile.b5, .sw.b5 { background: var(--seq-5); }
.tile.b5 { color: var(--seq-ink-5); }
.tile:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
.tile.hi { box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--ink); }
.seqlegend { display: flex; align-items: center; gap: 0; margin: 12px 0 4px; max-width: 720px; }
.seqlegend .sw { flex: 1; height: 12px; }
.seqlegend .sw:first-child { border-radius: 3px 0 0 3px; } .seqlegend .sw:last-child { border-radius: 0 3px 3px 0; }
.seqticks { display: flex; max-width: 720px; font-size: 11px; color: var(--muted); }
.seqticks span { flex: 1; text-align: right; }
.maptip { min-height: 2.6em; margin: 10px 0 0; font-size: 13px; color: var(--ink2); }
.maptip b { color: var(--ink); }
@media (max-width: 620px) { .tilegrid, .seqlegend, .seqticks { max-width: 100%; } .tile { font-size: 9px; } }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1180px; margin: 0 auto; padding: 28px 20px 60px; }
header h1 { font-size: 26px; margin: 0 0 4px; }
header p { color: var(--ink2); margin: 0; }
h2 { font-size: 19px; margin: 36px 0 4px; }
.lede { color: var(--ink2); margin: 0 0 14px; }
a { color: var(--series-1); }
.status { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; }
.dot { width: 10px; height: 10px; border-radius: 50%; background: var(--muted); display: inline-block; flex: none; }
.st-ok .dot { background: var(--good); }
.st-stale .dot, .st-restated .dot, .st-golden_mismatch .dot { background: var(--warning); }
.st-failed .dot, .st-suspect .dot { background: var(--critical); }
.readings { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 18px 12px 34px; margin: 0; }
.readings li { margin: 4px 0; }
.health { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
.health li { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
.health small { color: var(--ink2); display: block; margin-top: 2px; }
.health details { margin-top: 6px; }
.health details ul { margin: 4px 0 0; padding-left: 18px; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 16px; }
figure.card { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 14px 10px; min-width: 0; }
.cardhead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
figure h3 { font-size: 15px; margin: 0; font-weight: 600; }
.tools { display: inline-flex; align-items: center; gap: 8px; flex: none; }
.badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; color: var(--ink2); border: 1px solid var(--border); border-radius: 999px; padding: 1px 8px; }
.badge .dot { width: 8px; height: 8px; }
button.range { font: inherit; font-size: 11px; color: var(--ink2); background: transparent; border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; cursor: pointer; }
button.range:hover { color: var(--ink); }
.unit { color: var(--muted); font-size: 12px; }
.plot { width: 100%; margin-top: 8px; }
figure footer { color: var(--muted); font-size: 12px; margin-top: 6px; }
ul.lines { color: var(--muted); font-size: 12px; margin: 2px 0 0; padding-left: 18px; }
details { font-size: 12px; color: var(--ink2); margin-top: 6px; }
summary { cursor: pointer; }
details ul { margin: 4px 0 0; padding-left: 18px; }
table { border-collapse: collapse; font-variant-numeric: tabular-nums; font-size: 12px; margin-top: 6px; }
td, th { padding: 2px 8px; text-align: right; border-bottom: 1px solid var(--grid); }
th:first-child, td:first-child { text-align: left; }
.uplot .u-legend { font-size: 12px; color: var(--ink2); }
.changes { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; }
.changes ul { margin: 4px 0 0; padding-left: 18px; }
.method li { margin-bottom: 4px; }
.browse { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:14px; }
.browse .controls { display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:10px; }
.browse input[type=search] { flex:1 1 300px; min-width:0; font:inherit; font-size:14px; padding:5px 10px;
  color:var(--ink); background:var(--bg); border:1px solid var(--border); border-radius:6px; }
.browse select { font:inherit; font-size:13px; padding:4px 8px; color:var(--ink); background:var(--bg);
  border:1px solid var(--border); border-radius:6px; }
.browse .ctl { font-size:13px; color:var(--ink2); display:inline-flex; align-items:center; gap:5px; }
.tablewrap { max-height:420px; overflow:auto; border:1px solid var(--border); border-radius:8px; }
#browse-table { width:100%; margin:0; font-size:13px; }
#browse-table thead th { position:sticky; top:0; background:var(--surface); z-index:1; }
#browse-table tbody tr { cursor:pointer; }
#browse-table tbody tr:hover { background:var(--bg); }
#browse-table tbody tr[aria-selected="true"] { background:var(--band); }
#browse-table td.name { max-width:340px; }
#browse-detail { border:1px solid var(--border); border-radius:8px; padding:12px; margin-bottom:12px; }
.sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
.stamp { color: var(--muted); font-size: 12px; }
.nav { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--border);
  margin: 14px -20px 0; padding: 6px 20px; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; font-size: 13px; }
.nav a { color: var(--ink2); text-decoration: none; padding: 2px 0; }
.nav a:hover { color: var(--ink); }
.nav .spacer { flex: 1; }
.nav button { font: inherit; font-size: 12px; color: var(--ink2); background: transparent; border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; cursor: pointer; }
.readings a, .changes a.chartlink { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--muted); }
.readings a:hover, .changes a.chartlink:hover { color: var(--series-1); }
.due { color: var(--muted); font-size: 12px; margin: 6px 0 0; }
.endlabel { position: absolute; transform: translateY(-50%); font: 600 11px/1 system-ui, sans-serif; white-space: nowrap; pointer-events: none; font-variant-numeric: tabular-nums; }
.health .next { display: block; margin-top: 2px; }
.health .overdue { color: var(--warning); }
button.link { font: inherit; font-size: 11px; color: var(--ink2); background: transparent; border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; cursor: pointer; }
button.link:hover { color: var(--ink); }
.browse .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 6px; font-size: 12px; }
.browse .actions .picking { color: var(--series-1); }
figure.card:target, #browse-detail:target { outline: 2px solid var(--series-1); outline-offset: 2px; }
@media (max-width: 640px) {
  main { padding: 16px 12px 40px; }
  header h1 { font-size: 22px; }
  h2 { margin-top: 28px; }
  .nav { margin: 10px -12px 0; padding: 6px 12px; gap: 4px 10px; font-size: 12px; }
  .readings { padding: 10px 12px 10px 26px; }
  figure.card { padding: 10px 8px 8px; }
  .cardhead { flex-wrap: wrap; }
  .uplot .u-legend { font-size: 11px; }
  #browse-table { font-size: 12px; }
  #browse-table td.name { max-width: 200px; }
}
@media print {
  .nav, button, .tools { display: none !important; }
  figure.card { break-inside: avoid; }
}
</style>
</head>
<body>
<main>
<header>
  <h1>US credit card data</h1>
  <p>{{ tagline }}</p>
  <p class="stamp">Generated {{ generated_at }} · {{ n_series }} series · {{ n_facts }} observations · <a href="{{ repo_url }}">code and data</a> ·
    <span class="status st-{{ health_summary.worst }}"><span class="dot" aria-hidden="true"></span>{% if health_summary.n == 0 %}no sources loaded{% elif health_summary.n_ok == health_summary.n %}{{ health_summary.n }} source{{ 's' if health_summary.n != 1 else '' }} OK{% else %}{{ health_summary.n - health_summary.n_ok }} of {{ health_summary.n }} sources need attention ({{ health_summary.worst_label }}){% endif %}</span>
    as of {{ health_generated }} UTC · <a href="#health">source health</a></p>
  {% if upcoming %}<p class="due">Due in the next two weeks: {% for r in upcoming %}{{ r.label.split(',')[0] }} {{ r.next.period }} around {{ r.next.due }}{{ '; ' if not loop.last else '.' }}{% endfor %}</p>{% endif %}
</header>
<nav class="nav" aria-label="Sections">
  <a href="#readings">Readings</a>
  {% for panel in panels %}<a href="#panel-{{ panel.name | lower }}">{{ panel.name }}</a>{% endfor %}
  <a href="#browse">Browse</a>
  <a href="#changed">Changed</a>
  <a href="#health">Health</a>
  <a href="#method">Method</a>
  <span class="spacer"></span>
  <button type="button" id="theme" title="Switch between light and dark">Dark</button>
</nav>

<h2 id="readings">Latest readings</h2>
<p class="lede">Computed from the series charted below, nothing else. Change is against the same period a year earlier; the benchmark is the {{ benchmark_label }}.</p>
<ul class="readings">
{% for h in headlines %}
  <li><strong>{% if h.chart %}<a href="#{{ h.chart }}" title="Go to the chart">{{ h.label }}</a>{% else %}{{ h.label }}{% endif %}:</strong> {{ h.text }}</li>
{% else %}
  <li>No data loaded yet.</li>
{% endfor %}
</ul>
<h2>Thesis watch</h2>
<p class="lede">A dated analysis note reads the whole page together and names the readings that would prove it wrong.
They are checked here on every refresh.</p>
<div class="changes">
  <div><span class="status st-{{ 'ok' if thesis_holds else 'failed' }}"><span class="dot" aria-hidden="true"></span>{{ 'Holds' if thesis_holds else 'Broken' }}</span>
    &middot; <em>{{ thesis_claim }}</em> <span class="note">Stated {{ thesis_date }} in <a href="{{ thesis_href }}">{{ thesis_note }}</a>.</span></div>
  <ul>
  {% for t in thesis %}
    <li><strong>{{ '✓' if t.holds else ('✗' if t.holds is false else '?') }} {% if t.chart %}<a class="chartlink" href="#{{ t.chart }}" title="Go to the chart">{{ t.label }}</a>{% else %}{{ t.label }}{% endif %}:</strong>
      {{ t.text }}{% if t.holds is false %} &mdash; this test has broken{% endif %}. <span class="note">{{ t.why }}</span></li>
  {% endfor %}
  </ul>
</div>

<p class="stamp"><a href="latest.txt">Plain-text version</a> of these readings and the thesis watch, for pasting into a post. Charts open on the last {{ default_years }} years; the button on each card shows the full history. Shaded bands are NBER recessions.</p>

{% for panel in panels %}
<section class="panel" id="panel-{{ panel.name | lower }}">
  <h2>{{ panel.name }}</h2>
  <p class="lede">{{ panel.blurb }}</p>
  <div class="grid">
  {% for c in panel.charts %}
    <figure class="card" id="{{ c.id }}">
      <figcaption>
        <div class="cardhead">
          <h3>{{ c.title }}</h3>
          <div class="tools">
            {% if c.status != 'ok' %}<span class="badge st-{{ c.status }}" title="Source status"><span class="dot" aria-hidden="true"></span>{{ c.status_label }}</span>{% endif %}
            <button type="button" class="range" data-range="{{ c.id }}" hidden>Full history</button>
            <button type="button" class="link" data-link="{{ c.id }}" title="Copy a link to this chart">Link</button>
          </div>
        </div>
        <span class="unit">{{ c.unit_label }}</span>
      </figcaption>
      <div class="plot" data-chart="{{ c.id }}"></div>
      <footer>{{ c.footer }}{% if c.attempted %} · last fetch attempt {{ c.attempted }}{% endif %} · <a href="img/{{ c.id }}.png">PNG</a></footer>
      {% if c.footer_lines %}
      <ul class="lines">{% for l in c.footer_lines %}<li>{{ l }}</li>{% endfor %}</ul>
      {% endif %}
      {% if c.notes or c.about %}
      <details><summary>About this chart</summary>
        <ul>
        {% for n in c.notes %}<li>{{ n }}</li>{% endfor %}
        {% for a in c.about %}<li><strong>{{ a.label }}</strong>: {{ a.note }}{% if a.source_url %} <a href="{{ a.source_url }}">{{ a.source_label }}</a>{% endif %}</li>{% endfor %}
        </ul>
      </details>
      {% endif %}
      {% if c.checks %}
      <details><summary>Checked against the release ({{ c.checks | length }})</summary>
        <ul>
        {% for k in c.checks %}<li>{{ '✓' if k.ok else '✗' }} {{ k.series_label }}, {{ k.period }}: {{ '%.4g' | format(k.expected) }} per <a href="{{ k.origin_url }}">the release</a>{% if not k.ok %} (got {{ '%.4g' | format(k.actual) if k.actual is not none else 'nothing' }}){% endif %}</li>{% endfor %}
        </ul>
      </details>
      {% endif %}
      <details><summary>Table (last 36)</summary><div data-table="{{ c.id }}"></div></details>
    </figure>
  {% endfor %}
  </div>
</section>
{% endfor %}

<h2 id="statemap">Card distress by state</h2>
<p class="lede">Every area the New York Fed publishes, one square each, in a rough map of the country. Squares are
all the same size on purpose: this is not a map, and land area is not population. Drag the year to see the whole
history, and hover a square for its reading.</p>
<div class="statemap">
  <div class="controls">
    <label for="map-metric">Measure</label>
    <select id="map-metric"></select>
    <label for="map-year">Year</label>
    <input type="range" id="map-year" min="0" step="1">
    <output id="map-year-out" for="map-year"></output>
    <button type="button" class="link" data-link="statemap" title="Copy a link to this map">Link</button>
  </div>
  <div class="tilegrid" id="tilegrid" role="img" aria-label="Card distress by state"></div>
  <div class="seqlegend" id="map-legend" aria-hidden="true"></div>
  <div class="seqticks" id="map-ticks"></div>
  <p class="maptip" id="map-tip"></p>
  <details><summary>Table (every area, the year shown)</summary><div id="map-table"></div></details>
  <details><summary>About this map</summary><ul id="map-about"></ul></details>
</div>

<h2 id="browse">Browse every series</h2>
<p class="lede">The panels above answer particular questions. This is everything the pipeline loads:
{{ n_browse }} series, {{ n_uncharted }} of which are not on any chart above. Search, click a row to plot it, and
read the scope note before comparing it with anything.</p>
<div class="browse">
  <div class="controls">
    <label class="sr-only" for="browse-q">Search series</label>
    <input id="browse-q" type="search" placeholder="Search by name, entity or source, e.g. Capital One, utilization, score">
    <label for="browse-src" class="ctl">Source</label>
    <select id="browse-src">
      <option value="">All sources</option>
      {% for src, label in browse_sources %}<option value="{{ src }}">{{ label }}</option>{% endfor %}
    </select>
    <label class="ctl"><input id="browse-un" type="checkbox"> Only series with no chart</label>
    <span class="note" id="browse-count"></span>
  </div>
  <div id="browse-detail" hidden>
    <div class="cardhead"><h3 id="browse-title"></h3><span class="unit" id="browse-unit"></span></div>
    <div class="plot" id="browse-plot"></div>
    <footer id="browse-footer"></footer>
    <div class="actions">
      <button type="button" class="link" id="browse-compare">Compare with another series</button>
      <button type="button" class="link" id="browse-clear" hidden>Remove comparison</button>
      <a id="browse-csv" class="link" href="#" download="series.csv">Download CSV</a>
      <button type="button" class="link" id="browse-link">Link</button>
      <span id="browse-hint"></span>
    </div>
    <details id="browse-about"><summary>About this series</summary><p id="browse-note"></p></details>
  </div>
  <div class="tablewrap"><table id="browse-table">
    <thead><tr><th>Series</th><th>Entity</th><th>Source</th><th>Cadence</th><th>Latest</th><th>Value</th></tr></thead>
    <tbody></tbody>
  </table></div>
</div>

<h2 id="changed">What changed</h2>
<div class="changes">
  {% if not run %}
  <div>No refresh run recorded yet.</div>
  {% else %}
  <div>Latest run {{ run[:16].replace('T', ' ') }} UTC.
    {% if revisions.n %}{{ revisions.n }} value{{ 's' if revisions.n != 1 else '' }} revised by the source{% if revisions.listed %}, largest first{% endif %}{% if revisions.n > revisions.listed | length %} ({{ revisions.listed | length }} listed; revisions under 0.1% are only counted){% endif %}.{% else %}No values revised by the source.{% endif %}
    {% if has_revisions_csv %}<a href="data/revisions.csv">Every revision ever logged</a>.{% endif %}</div>
  {% if revisions.listed %}
  <ul>
  {% for r in revisions.listed %}
    <li>{{ r.name }}, {{ r.period }}: {{ '%.4g' | format(r.old) }} → {{ '%.4g' | format(r.new) }} ({{ r.rel }})</li>
  {% endfor %}
  </ul>
  {% endif %}
  {% if new_periods %}
  <div>New periods loaded in this run:</div>
  <ul>
  {% for p in new_periods %}
    <li>{{ p.label }}: {{ p.periods | join('; ') }}</li>
  {% endfor %}
  </ul>
  {% else %}
  <div>No new periods in this run.</div>
  {% endif %}
  {% endif %}
</div>

<h2 id="health">Source health</h2>
<p class="lede">Each source is fetched in full every run. A failed source keeps its previous data and is flagged here and on its charts; a chart is never silently stale.</p>
<ul class="health">
{% for s in health %}
  <li class="st-{{ s.status }}">
    <span class="status"><span class="dot" aria-hidden="true"></span>{{ s.label }} · {{ s.status_label }}</span>
    <small>latest period {{ s.last_period_end }} · last fetch {{ s.pulled_at }} · {{ s.n_series }} series, {{ s.rows }} rows</small>
    {% if s.next %}<small class="next{% if s.next.overdue %} overdue{% endif %}">{{ s.next.text }}</small>{% endif %}
    {% if s.messages %}
    <details><summary>{{ s.messages | length }} note{{ 's' if s.messages | length != 1 else '' }}</summary>
      <ul>{% for m in s.messages %}<li>{{ m }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
  </li>
{% else %}
  <li class="st-failed"><span class="status"><span class="dot"></span>No sources loaded yet</span></li>
{% endfor %}
</ul>

<h2 id="method">Data and method</h2>
<ul class="method">
  <li><a href="data/facts.csv">Download every series as one CSV</a> (metric, entity, tier, period_end, period_type, value, source, pulled_at).</li>
  <li>Every period is dated to its last day: month end, quarter end, or the Wednesday for weekly bank data. A quarterly survey taken in May is shown at June 30; the July Senior Loan Officer survey, which asks about the quarter just ended, is shown at June 30.</li>
  <li>Step charts hold each reading across its own period. Nothing is interpolated between readings. Charts open on the last {{ default_years }} years; the button on each card shows the full history.</li>
  <li>Shaded bands are NBER recessions (peak month to trough month). Dashed grey lines are the {{ benchmark_label }} of the first series on the chart, the last full expansion before the pandemic.</li>
  <li>SA means seasonally adjusted. Series are labeled SA or NSA and are never compared across that line.</li>
  <li>Different sources measure different populations. G.19 covers all lenders; the H.8, charge-off and APR series cover commercial banks only; the Y-14 series cover the largest banks; the NY Fed series are credit reports, all lenders; the FDIC series are bank charters. Notes under each chart say which, with a link to the source.</li>
  <li>"Data as of" on a chart is when its newest value was loaded. A card carries a status badge when its source is not OK; "last fetch attempt" is then the run that failed. "Checked against the release" lists the numbers the pipeline reproduces from the source's own release page on every run.</li>
  <li>The latest readings are computed from the series on the page: latest value, change against the same period a year earlier, the {{ benchmark_label }} for rates, and whether the value is the highest or lowest in at least three years. No model writes any of it.</li>
  <li>Sources: {{ sources | join('; ') }}. The Federal Reserve Board series (G.19 Consumer Credit, H.8 Assets and Liabilities of Commercial Banks, Charge-Off and Delinquency Rates, Senior Loan Officer Opinion Survey) are retrieved from FRED, Federal Reserve Bank of St. Louis.</li>
  <li>A dated analysis note reading the whole page together, with the numbers behind it and the test that would prove it wrong, is at <a href="{{ thesis_href }}">{{ thesis_note }}</a> (also in the repository). The page above is mechanical; that note is editorial and dated.</li>
  <li>Every chart is also written as a PNG (the link in its footer), drawn from the same data as the page and showing the same {{ default_years }}-year window. The image carries no pull date, so it changes only when the data does.</li>
  <li>"Expected around" under each source is the period after the newest one loaded, plus the lag its releases have shown; it is a reader's expectation, not a status. The loader marks a source stale on its own rule.</li>
</ul>
</main>

<script>{{ uplot_js | safe }}</script>
<script>window.CARDDASH = {{ payload_json | safe }};</script>
<script>
(function () {
  var D = window.CARDDASH;
  var css = getComputedStyle(document.documentElement);
  function v(name) { return css.getPropertyValue(name).trim(); }
  function tz(ts) { return uPlot.tzDate(new Date(ts * 1e3), 'Etc/UTC'); }
  function fmtVal(x, unit) {
    if (x == null || isNaN(x)) return '–';
    if (unit === 'pct') return x.toFixed(2) + '%';
    if (unit === 'pp') return x.toFixed(2) + ' pp';
    if (unit === 'usd_bn') return '$' + x.toLocaleString('en-US', { maximumFractionDigits: 1 }) + 'bn';
    if (unit === 'score') return Math.round(x).toString();
    return x.toLocaleString('en-US');
  }
  function fmtAxis(x, unit) {
    if (unit === 'pct') return x + '%';
    if (unit === 'usd_bn') return '$' + x.toLocaleString('en-US') + 'bn';
    return x.toLocaleString('en-US');
  }
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function fmtPeriod(ts, pt) {
    if (ts == null) return '–';
    var d = new Date(ts * 1e3), y = d.getUTCFullYear(), m = d.getUTCMonth();
    if (pt === 'M') return MONTHS[m] + ' ' + y;
    if (pt === 'Q') return y + ' Q' + (Math.floor(m / 3) + 1);
    if (pt === 'H') return y + ' H' + (m < 6 ? 1 : 2);
    if (pt === 'A') return String(y);
    return d.toISOString().slice(0, 10);
  }
  var HEIGHT = 250, YEAR = 365.25 * 86400;

  // theme toggle: the choice is remembered per browser and wins over the system setting both ways
  (function () {
    var btn = document.getElementById('theme');
    var root = document.documentElement;
    function current() {
      var t = root.getAttribute('data-theme');
      if (t) return t;
      return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    if (btn) {
      btn.textContent = current() === 'dark' ? 'Light' : 'Dark';
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('carddash-theme', next); } catch (e) {}
        root.setAttribute('data-theme', next);
        location.reload();  // chart colors are read once at draw time
      });
    }
  })();

  // the latest value of every series printed in the right margin, level with the end of its line, so a reader does
  // not have to hover. HTML spans over the canvas (the canvas clips at the plot edge), repositioned on every draw.
  var LABEL_PAD = 62;
  function labelEnds(u) {
    var wrap = u.root.querySelector('.u-wrap');
    if (!wrap) return;
    if (!u._labels) {
      u._labels = [];
      for (var k = 1; k < u.series.length; k++) {
        var el = document.createElement('span');
        el.className = 'endlabel';
        wrap.appendChild(el);
        u._labels.push(el);
      }
    }
    var xmax = u.scales.x.max, used = [], dpr = devicePixelRatio || 1;
    var x = (u.bbox.left + u.bbox.width) / dpr + 4;
    for (var k = 1; k < u.series.length; k++) {
      var s = u.series[k], el = u._labels[k - 1];
      el.hidden = true;
      if (!s.show || s._benchmark) continue;
      var ys = u.data[k], i = -1;
      for (var j = ys.length - 1; j >= 0; j--) {
        if (ys[j] != null && u.data[0][j] <= xmax) { i = j; break; }
      }
      if (i < 0) continue;
      var y = u.valToPos(ys[i], s.scale || 'y', true) / dpr;
      for (var t = 0; t < 8; t++) {
        var clash = used.some(function (uy) { return Math.abs(uy - y) < 13; });
        if (!clash) break;
        y += 13;
      }
      used.push(y);
      el.textContent = s._fmt(ys[i]);
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      el.style.color = typeof s.stroke === 'function' ? s.stroke(u, k) : s.stroke;
      el.hidden = false;
    }
  }

  function copyLink(hash, btn) {
    var url = location.href.split('#')[0] + '#' + hash;
    var done = function () { var old = btn.textContent; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = old; }, 1500); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, function () { location.hash = hash; });
    else { location.hash = hash; done(); }
  }
  document.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-link]');
    if (b) copyLink(b.getAttribute('data-link'), b);
  });

  // NBER recessions, painted under the series
  function shadeRecessions(u) {
    var ctx = u.ctx, left = u.bbox.left, right = left + u.bbox.width;
    ctx.save();
    ctx.fillStyle = v('--recession');
    D.recessions.forEach(function (r) {
      var x0 = Math.max(u.valToPos(r[0], 'x', true), left), x1 = Math.min(u.valToPos(r[1], 'x', true), right);
      if (x1 > x0) ctx.fillRect(x0, u.bbox.top, x1 - x0, u.bbox.height);
    });
    ctx.restore();
  }

  // ---- one cursor for the whole page ----
  // Hovering any chart marks the same date on every other chart. The x scale only: the charts are
  // in different units, so sharing a y scale or a series focus would be meaningless. The series
  // browser at the foot of the page is deliberately left out: it is a separate tool with its own
  // axis and it is never on screen at the same time as a panel chart.
  var SYNC_KEY = 'carddash';

  // Period data is drawn as a step aligned to the period end, so the segment under the pointer
  // belongs to the period that CONTAINS the date, not to the nearest period end. Across cadences
  // that is the whole point: a date in March 2024 sits in the annual period ending 2024-12-31,
  // while the NEAREST period end is 2023-12-31.
  function containingIdx(u, seriesIdx, closestIdx, xVal) {
    if (closestIdx == null) return closestIdx;
    var xs = u.data[0];
    if (xVal <= xs[closestIdx]) return closestIdx;
    return closestIdx + 1 < xs.length ? closestIdx + 1 : closestIdx;
  }

  D.charts.forEach(function (c) {
    var el = document.querySelector('[data-chart="' + c.id + '"]');
    if (!el) return;
    var u, xs = c.data[0], n = xs.length;

    // This chart answers the page cursor only for dates it actually holds and is currently showing.
    // Otherwise uPlot clamps to an endpoint and the legend reads out a value for a date that is not
    // on this chart at all. Zoom and dblclick stay per-chart: only the cursor is shared.
    function covers(type, src, sx) {
      if (!u || !src || src === u) return false;
      if (type !== 'mousemove' && type !== 'mouseleave') return false;
      var sc = u.scales.x, xv = sx < 0 ? null : src.posToVal(sx, 'x');
      if (xv == null || xv < xs[0] || xv > xs[n - 1] || xv < sc.min || xv > sc.max) {
        u.setCursor({ left: -10, top: -10 });
        return false;
      }
      return true;
    }
    var series = [{ label: 'Period', value: function (u, ts) { return fmtPeriod(ts, c.period_type); } }];
    c.series.forEach(function (s, i) {
      var cfg = {
        label: s.label,
        stroke: s.benchmark ? v('--muted') : (v('--series-' + (i + 1)) || v('--series-1')),
        width: s.benchmark ? 1 : 2,
        spanGaps: c.span_gaps !== false,
        points: { show: false },
        value: function (u, val) { return fmtVal(val, s.unit || c.unit); },
        _benchmark: !!s.benchmark,
        _fmt: function (val) { return fmtVal(val, s.unit || c.unit); }
      };
      if (c.step && !s.benchmark) cfg.paths = uPlot.paths.stepped({ align: -1 });
      if (s.dash || s.benchmark) cfg.dash = [6, 4];
      series.push(cfg);
    });
    var scales = { x: { time: true }, y: {} };
    if (c.y_zero) {
      // y includes zero so a rate chart is never zoomed into a misleading window; score charts opt out
      scales.y.range = function (u, dmin, dmax) {
        var lo = Math.min(0, dmin), hi = Math.max(0, dmax), pad = (hi - lo) * 0.06 || 1;
        return [lo < 0 ? lo - pad : 0, hi + pad];
      };
    }
    var opts = {
      width: el.clientWidth || 600,
      height: HEIGHT,
      tzDate: tz,
      series: series,
      scales: scales,
      axes: [
        { stroke: v('--muted'), grid: { stroke: v('--grid'), width: 1 }, ticks: { stroke: v('--grid'), width: 1 } },
        { stroke: v('--muted'), grid: { stroke: v('--grid'), width: 1 }, ticks: { show: false }, size: 64,
          values: function (u, vals) { return vals.map(function (x) { return fmtAxis(x, c.unit); }); } }
      ],
      cursor: {
        drag: { x: true, y: false },
        dataIdx: c.step ? containingIdx : null,
        sync: { key: SYNC_KEY, setSeries: false, scales: ['x', null], filters: { sub: covers } }
      },
      legend: { show: true },
      padding: [null, LABEL_PAD, null, null],
      hooks: { drawClear: [shadeRecessions], draw: [labelEnds] }
    };
    // a band fills between two series: the range of terms offered across credit tiers
    if (c.band) opts.bands = [{ series: c.band, fill: v('--band') }];
    u = new uPlot(opts, c.data, el);
    window.addEventListener('resize', function () { u.setSize({ width: el.clientWidth, height: HEIGHT }); });

    // the page opens on the last N years; the button shows the full history
    var btn = document.querySelector('[data-range="' + c.id + '"]');
    if (btn && n > 1 && (xs[n - 1] - xs[0]) > (D.default_years + 0.5) * YEAR) {
      var full = false;
      var apply = function () {
        if (full) u.setScale('x', { min: xs[0], max: xs[n - 1] });
        else u.setScale('x', { min: xs[n - 1] - D.default_years * YEAR, max: xs[n - 1] });
        btn.textContent = full ? 'Last ' + D.default_years + ' years' : 'Full history';
      };
      btn.hidden = false;
      btn.addEventListener('click', function () { full = !full; apply(); });
      apply();
    }

    var t = document.querySelector('[data-table="' + c.id + '"]');
    if (t) {
      var start = Math.max(0, n - 36);
      var html = '<table><thead><tr><th>Period</th>';
      c.series.forEach(function (s) { html += '<th>' + s.label + '</th>'; });
      html += '</tr></thead><tbody>';
      for (var i = n - 1; i >= start; i--) {
        html += '<tr><td>' + fmtPeriod(xs[i], c.period_type) + '</td>';
        for (var k = 1; k < c.data.length; k++) html += '<td>' + fmtVal(c.data[k][i], c.series[k - 1].unit || c.unit) + '</td>';
        html += '</tr>';
      }
      t.innerHTML = html + '</tbody></table>';
    }
  });

  // ---- card distress by state: a tile-grid cartogram ----
  // Magnitude, so the color job is sequential: one hue over six steps, never the series palette (that channel
  // means identity). Six bins because past about seven, adjacent classes stop being tellable apart. Bin edges are
  // quantiles of the whole history of the chosen measure, not of the year on screen, so dragging the year moves
  // the colors rather than re-cutting the scale under the reader.
  (function () {
    var M = D.state_map;
    if (!M || !M.metrics.length) return;
    var STEPS = 6;
    var grid = document.getElementById('tilegrid');
    var sel = document.getElementById('map-metric');
    var slider = document.getElementById('map-year');
    var yearOut = document.getElementById('map-year-out');
    var legend = document.getElementById('map-legend');
    var ticks = document.getElementById('map-ticks');
    var tip = document.getElementById('map-tip');
    var tableEl = document.getElementById('map-table');
    var aboutEl = document.getElementById('map-about');
    var cur = 0, yearIdx = M.years.length - 1, pinned = null;

    M.metrics.forEach(function (m, i) {
      var o = document.createElement('option');
      o.value = String(i); o.textContent = m.label; sel.appendChild(o);
    });
    slider.max = String(M.years.length - 1);
    slider.value = String(yearIdx);

    function fmt(v, unit) { return v == null ? '–' : fmtVal(v, unit); }

    // quantile edges over every area-year of this measure
    function edges(m) {
      if (m._edges) return m._edges;
      var all = [];
      Object.keys(m.values).forEach(function (code) {
        var byYear = m.values[code];
        Object.keys(byYear).forEach(function (y) { if (byYear[y] != null) all.push(byYear[y]); });
      });
      all.sort(function (a, b) { return a - b; });
      var e = [];
      for (var k = 1; k < STEPS; k++) e.push(all[Math.floor(all.length * k / STEPS)]);
      m._edges = { cuts: e, lo: all[0], hi: all[all.length - 1] };
      return m._edges;
    }
    function bin(v, e) {
      if (v == null) return null;
      for (var k = 0; k < e.cuts.length; k++) if (v < e.cuts[k]) return k;
      return STEPS - 1;
    }

    function say(code, m, year) {
      var val = (m.values[code] || {})[year];
      var nat = m.national[year];
      if (val == null) {
        tip.innerHTML = '<b>' + code + '</b>, ' + year + ': no reading. Puerto Rico’s series stops in 2016.';
        return;
      }
      var rel = nat == null ? '' : (val === nat ? ', the same as the nation'
        : ', ' + fmtVal(Math.abs(val - nat), m.unit) + (val > nat ? ' above' : ' below') + ' the national '
          + fmtVal(nat, m.unit));
      tip.innerHTML = '<b>' + code + '</b>, ' + year + ': <b>' + fmtVal(val, m.unit) + '</b>' + rel + '.';
    }

    function draw() {
      var m = M.metrics[cur], year = M.years[yearIdx], e = edges(m);
      yearOut.textContent = String(year);
      grid.innerHTML = '';
      grid.style.gridTemplateRows = 'repeat(' + M.rows + ', minmax(0, 1fr))';
      M.tiles.forEach(function (t) {
        // NB: `v` is the CSS-variable helper from the top of this script; the reading is `val`
        var val = (m.values[t.code] || {})[year], b = bin(val, e);
        var el = document.createElement('div');
        el.className = 'tile' + (pinned === t.code ? ' hi' : '');
        el.style.gridRow = String(t.row + 1);
        el.style.gridColumn = String(t.col + 1);
        el.textContent = t.code;
        el.setAttribute('data-code', t.code);
        el.setAttribute('data-has', val == null ? '0' : '1');
        if (b != null) el.classList.add('b' + b);   // a class, not an inline colour, so the theme stays live
        el.title = t.code + ' ' + year + ': ' + fmt(val, m.unit);
        grid.appendChild(el);
      });
      legend.innerHTML = '';
      for (var k = 0; k < STEPS; k++) {
        var sw = document.createElement('div');
        sw.className = 'sw b' + k;
        legend.appendChild(sw);
      }
      ticks.innerHTML = '';
      e.cuts.concat([e.hi]).forEach(function (c) {
        var sp = document.createElement('span');
        sp.textContent = fmtVal(c, m.unit);
        ticks.appendChild(sp);
      });
      var nat = m.national[year];
      tip.innerHTML = pinned ? tip.innerHTML
        : 'Nation, ' + year + ': <b>' + fmt(nat, m.unit) + '</b>. Hover a square for its reading.';

      var order = M.tiles.map(function (t) { return [t.code, (m.values[t.code] || {})[year]]; })
        .filter(function (r) { return r[1] != null; })
        .sort(function (a, b2) { return b2[1] - a[1]; });
      var html = '<table><thead><tr><th>Area</th><th>' + m.label + '</th></tr></thead><tbody>';
      order.forEach(function (r) { html += '<tr><td>' + r[0] + '</td><td>' + fmtVal(r[1], m.unit) + '</td></tr>'; });
      tableEl.innerHTML = html + '</tbody></table>';
      aboutEl.innerHTML = '<li>' + m.note + '</li>'
        + '<li>Squares are equal size, so this shows every area alike and never lets land area stand in for '
        + 'population. Six bins, cut at quantiles of the whole history, so the scale does not move as you drag '
        + 'the year.</li>'
        + '<li>Puerto Rico is in the source and is not a state; its series stops in 2016.</li>';
    }

    sel.addEventListener('change', function () { cur = +sel.value; pinned = null; draw(); });
    slider.addEventListener('input', function () { yearIdx = +slider.value; draw(); });
    grid.addEventListener('mouseover', function (ev) {
      var t = ev.target.closest('.tile');
      if (t && !pinned) say(t.getAttribute('data-code'), M.metrics[cur], M.years[yearIdx]);
    });
    grid.addEventListener('click', function (ev) {
      var t = ev.target.closest('.tile');
      if (!t) return;
      var code = t.getAttribute('data-code');
      pinned = pinned === code ? null : code;
      draw();
      if (pinned) say(code, M.metrics[cur], M.years[yearIdx]);
    });
    draw();
  })();

  // ---- browse every series ----
  (function () {
    var B = D.browse, all = B.series, body = document.querySelector('#browse-table tbody');
    if (!body || !all.length) return;
    var q = document.getElementById('browse-q'), src = document.getElementById('browse-src');
    var un = document.getElementById('browse-un'), count = document.getElementById('browse-count');
    var detail = document.getElementById('browse-detail'), plotEl = document.getElementById('browse-plot');
    var chart = null, current = null, other = null, picking = false;
    var cmpBtn = document.getElementById('browse-compare'), clearBtn = document.getElementById('browse-clear');
    var csvA = document.getElementById('browse-csv'), hint = document.getElementById('browse-hint');
    var linkBtn = document.getElementById('browse-link');

    function seriesRows(s) {
      var grid = B.grids[s.grid], out = [];
      for (var i = 0; i < s.values.length; i++) if (s.values[i] != null) out.push([grid[s.start + i], s.values[i]]);
      return out;
    }
    function csvFor(list) {
      var lines = ['period_end,' + list.map(function (s) { return '"' + s.name.replace(/"/g, '""') + ' [' + s.unit + ']"'; }).join(',')];
      var byDate = {};
      list.forEach(function (s, k) {
        seriesRows(s).forEach(function (r) { (byDate[r[0]] = byDate[r[0]] || [])[k] = r[1]; });
      });
      Object.keys(byDate).map(Number).sort(function (a, b) { return a - b; }).forEach(function (ts) {
        var row = byDate[ts];
        lines.push(new Date(ts * 1e3).toISOString().slice(0, 10) + ',' + list.map(function (_, k) { return row[k] == null ? '' : row[k]; }).join(','));
      });
      return lines.join('\n') + '\n';
    }
    function setCsv() {
      var list = other ? [current, other] : [current];
      if (csvA.href && csvA.href.indexOf('blob:') === 0) URL.revokeObjectURL(csvA.href);
      csvA.href = URL.createObjectURL(new Blob([csvFor(list)], { type: 'text/csv' }));
      csvA.download = (current.metric + (other ? '_vs_' + other.metric : '')) + '.csv';
    }

    function fmt(s) { return fmtVal(s.last_value, s.unit); }
    function rows(list) {
      var html = '';
      list.forEach(function (s, i) {
        html += '<tr data-key="' + s.key.replace(/"/g, '&quot;') + '" tabindex="0">'
          + '<td class="name">' + s.name + (s.charted ? '' : ' <span class="note">(no chart)</span>') + '</td>'
          + '<td>' + s.entity + (s.tier && s.tier !== 'all' ? ' &middot; ' + s.tier : '') + '</td>'
          + '<td>' + s.source + '</td><td>' + s.cadence + '</td>'
          + '<td>' + s.last_period + '</td><td>' + fmt(s) + '</td></tr>';
      });
      body.innerHTML = html;
    }
    function filtered() {
      var text = (q.value || '').toLowerCase().trim(), s0 = src.value, only = un.checked;
      return all.filter(function (s) {
        if (s0 && s.source !== s0) return false;
        if (only && s.charted) return false;
        if (!text) return true;
        return (s.name + ' ' + s.entity + ' ' + s.metric + ' ' + s.source_label + ' ' + s.tier).toLowerCase().indexOf(text) >= 0;
      });
    }
    function refresh() {
      var list = filtered();
      rows(list);
      count.textContent = list.length + ' of ' + all.length + ' series';
      if (current) markSelected(current.key);
    }
    function markSelected(key) {
      Array.prototype.forEach.call(body.querySelectorAll('tr'), function (tr) {
        tr.setAttribute('aria-selected', tr.getAttribute('data-key') === key ? 'true' : 'false');
      });
    }
    function draw(s) {
      current = s;
      detail.hidden = false;
      document.getElementById('browse-title').textContent = s.name;
      document.getElementById('browse-unit').textContent = s.unit_label;
      var foot = 'Source: ' + s.source_label + ' &middot; ' + s.cadence + ' &middot; ' + s.n
        + ' observations &middot; latest ' + s.last_period + ' at ' + fmtVal(s.last_value, s.unit);
      if (s.source_url) foot += ' &middot; <a href="' + s.source_url + '">source</a>';
      document.getElementById('browse-footer').innerHTML = foot;
      var about = document.getElementById('browse-about');
      document.getElementById('browse-note').textContent = s.note || '';
      about.hidden = !s.note;
      // one date grid for the plotted series: the union of their dates, nulls where a series has no reading
      var list = other ? [s, other] : [s];
      var dates = {};
      list.forEach(function (q) { seriesRows(q).forEach(function (r) { dates[r[0]] = true; }); });
      var xs = Object.keys(dates).map(Number).sort(function (a, b) { return a - b; });
      var pos = {};
      xs.forEach(function (ts, i) { pos[ts] = i; });
      var data = [xs];
      var seriesCfg = [{ label: 'Period', value: function (u, ts) { return fmtPeriod(ts, s.period_type); } }];
      list.forEach(function (q, k) {
        var ys = new Array(xs.length).fill(null);
        seriesRows(q).forEach(function (r) { ys[pos[r[0]]] = r[1]; });
        data.push(ys);
        var stepped = q.period_type !== 'D' && q.period_type !== 'W';
        var sameUnit = k === 0 || q.unit === s.unit;
        var cfg = {
          label: q.name, stroke: v('--series-' + (k + 1)), width: 2, spanGaps: true, points: { show: false },
          scale: sameUnit ? 'y' : 'y2',
          value: function (u, val) { return fmtVal(val, q.unit); },
          _fmt: function (val) { return fmtVal(val, q.unit); }
        };
        if (stepped) cfg.paths = uPlot.paths.stepped({ align: -1 });
        seriesCfg.push(cfg);
      });
      var twoAxes = other && other.unit !== s.unit;
      var axes = [
        { stroke: v('--muted'), grid: { stroke: v('--grid'), width: 1 }, ticks: { stroke: v('--grid'), width: 1 } },
        { stroke: v('--muted'), grid: { stroke: v('--grid'), width: 1 }, ticks: { show: false }, size: 64,
          values: function (u, vals) { return vals.map(function (x) { return fmtAxis(x, s.unit); }); } }
      ];
      if (twoAxes) axes.push({ scale: 'y2', side: 1, stroke: v('--series-2'), grid: { show: false }, ticks: { show: false }, size: 64,
        values: function (u, vals) { return vals.map(function (x) { return fmtAxis(x, other.unit); }); } });
      var opts = {
        width: plotEl.clientWidth || 600, height: 260, tzDate: tz,
        series: seriesCfg,
        scales: { x: { time: true }, y: {}, y2: {} },
        axes: axes,
        cursor: { drag: { x: true, y: false } }, legend: { show: true },
        padding: [null, twoAxes ? 8 : LABEL_PAD, null, null],
        hooks: { drawClear: [shadeRecessions], draw: [labelEnds] }
      };
      if (chart) { chart.destroy(); chart = null; }
      chart = new uPlot(opts, data, plotEl);
      markSelected(s.key);
      clearBtn.hidden = !other;
      cmpBtn.hidden = !!other;
      hint.textContent = other ? (twoAxes ? 'Second series on the right axis.' : 'Both series on one axis.') : '';
      setCsv();
      if (history.replaceState) history.replaceState(null, '', '#series=' + encodeURIComponent(s.key) + (other ? '&vs=' + encodeURIComponent(other.key) : ''));
    }
    var byKey = {};
    all.forEach(function (s) { byKey[s.key] = s; });
    function pick(s) {
      if (picking && current && s.key !== current.key) { other = s; picking = false; hint.classList.remove('picking'); draw(current); return; }
      other = null; draw(s);
    }
    cmpBtn.addEventListener('click', function () {
      picking = true; hint.textContent = 'Now click the series to compare with.'; hint.classList.add('picking');
    });
    clearBtn.addEventListener('click', function () { other = null; if (current) draw(current); });
    linkBtn.addEventListener('click', function () {
      if (!current) return;
      copyLink('series=' + encodeURIComponent(current.key) + (other ? '&vs=' + encodeURIComponent(other.key) : ''), linkBtn);
    });
    body.addEventListener('click', function (e) {
      var tr = e.target.closest('tr[data-key]');
      if (tr && byKey[tr.getAttribute('data-key')]) pick(byKey[tr.getAttribute('data-key')]);
    });
    body.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      var tr = e.target.closest('tr[data-key]');
      if (tr && byKey[tr.getAttribute('data-key')]) { e.preventDefault(); pick(byKey[tr.getAttribute('data-key')]); }
    });
    [q, src, un].forEach(function (el) { el.addEventListener('input', refresh); });
    window.addEventListener('resize', function () { if (chart) chart.setSize({ width: plotEl.clientWidth, height: 260 }); });
    refresh();
    var m = /#series=([^&]+)/.exec(location.hash || ''), m2 = /[&#]vs=([^&]+)/.exec(location.hash || '');
    if (m2 && byKey[decodeURIComponent(m2[1])]) other = byKey[decodeURIComponent(m2[1])];
    if (m && byKey[decodeURIComponent(m[1])]) draw(byKey[decodeURIComponent(m[1])]);
  })();
})();
</script>
</body>
</html>
