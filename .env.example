# Copy to .env (gitignored) and fill in. Loaded by src/carddash/cli.py at startup.
# The same two values exist as Actions secrets on the repo, so CI already has them.

# FRED API key. Free, instant: https://fredaccount.stlouisfed.org/apikeys
# Without it the `fred` fetcher fails and the health strip goes red.
FRED_API_KEY=

# A contact email. Appended to the User-Agent that identifies this pipeline to
# data providers. The SEC requires a reachable contact and refuses any
# User-Agent containing a URL, so this must be a bare email address.
CARDDASH_CONTACT=
